# =====================================================
# RAG Service 环境变量配置示例
#
# 使用说明：
# 1. 复制本文件为 .env
# 2. 根据实际情况填写配置
# 3. .env 只在本地/服务器保存，不提交 Git
# =====================================================

# ==================== Embedding 配置 ====================
# 当前 RAG 入库需要 embedding。
# 注意：DeepSeek 适合作为聊天 LLM，不建议作为本项目 embedding 源。
# 如果没有 embedding 服务，可临时使用 simple_hash，但检索效果会较差。

# 可选：
# simple_hash          开发测试用，无需 API key，检索效果较弱
# openai_compatible   使用支持 /v1/embeddings 的 OpenAI 兼容服务
EMBEDDING_PROVIDER=simple_hash

# 当 EMBEDDING_PROVIDER=openai_compatible 时填写
OPENAI_API_KEY=your_embedding_api_key_here

# OpenAI 官方：
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# 其他兼容服务必须确认支持 /v1/embeddings
# 例如阿里百炼兼容模式：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding 模型名称
# OpenAI: text-embedding-3-small / text-embedding-3-large
# 阿里百炼等请填写其实际支持的 embedding 模型
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 本地 embedding 模型，当前如果代码未实现本地分支，则仅作为预留
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2


# ==================== 路径配置 ====================

# PDF / OCR 文本知识库目录
KNOWLEDGE_PATH=./rag-service/knowledge

# 当前项目实际使用 SQLite store.db。
# 目录名保留 chroma 是历史命名，不代表一定使用 Chroma SDK。
CHROMA_PERSIST_DIRECTORY=./rag-service/vector_store/chroma

# OCR 输出目录
OCR_OUTPUT_DIR=./rag-service/knowledge/ocr_book


# ==================== RAG 服务配置 ====================

RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=3001
RAG_DEFAULT_TOP_K=3


# ==================== OCR 配置 ====================

OCR_DEFAULT_START_PAGE=1
OCR_DEFAULT_END_PAGE=50
OCR_LANGUAGE=ch
OCR_ZOOM=2.0


# ==================== 检索配置 ====================

BM25_TOP_K=50
VECTOR_TOP_K=50
RRF_K=60
RRF_TOP_N=30
RERANK_TOP_K=8
RERANKER_PROVIDER=none


# ==================== 日志配置 ====================

LOG_LEVEL=INFO
ENABLE_VERBOSE_RAG_LOGS=false