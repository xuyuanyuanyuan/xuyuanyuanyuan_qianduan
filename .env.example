# =====================================================
# Project environment example
#
# Usage:
# 1. Copy this file to .env
# 2. Fill real keys locally
# 3. Do not commit .env
# =====================================================

# ---------- Next.js frontend ----------
PORT=3000
NODE_ENV=production

# ---------- Chat LLM ----------
# Supported values in current frontend code:
# - mock
# - deepseek
# - openai_compatible
MOCK_MODE=false
LLM_PROVIDER=deepseek
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TOP_P=1.0
ENABLE_VERBOSE_RAG_LOGS=false

# ---------- Engineering Agentic Answer Orchestrator ----------
# agent: use query analysis + RAG anchors + general LLM reasoning + answer merger.
# rag: keep the legacy single-path RAG prompt.
ANSWER_MODE=agent
AGENT_ENABLE_SELF_ASK=true
AGENT_ENABLE_GENERAL_ANSWER=true
AGENT_ENABLE_JUDGE=true
AGENT_ALLOW_GENERAL_FALLBACK=true
AGENT_TIMEOUT_MS=60000
AGENT_RAG_TOP_K=5
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_LONG_ANSWER_MAX_CHARS=16000
AGENT_ENABLE_LONG_ANSWER=true
# Per-stage output token budgets. Each falls back to AGENT_MAX_OUTPUT_TOKENS
# when unset, and to a built-in default when neither is set. Judge is the
# final synthesis step and needs the largest budget since it has to restate
# the merged knowledge + general answer content.
AGENT_KNOWLEDGE_MAX_OUTPUT_TOKENS=4000
AGENT_GENERAL_MAX_OUTPUT_TOKENS=7000
AGENT_JUDGE_MAX_OUTPUT_TOKENS=8000
# Reply presentation: natural/compact by default instead of a fixed
# "综合回答 / 知识库情况 / ... / 置信度" template every time.
AGENT_SHOW_CONFIDENCE=false
AGENT_COMPACT_ANSWER=true
AGENT_SHOW_SOURCES=never
AGENT_SHOW_KNOWLEDGE_STATUS=false
AGENT_VERBOSE_LOGS=false

# ---------- RAG API called by Next.js ----------
RAG_API_URL=http://localhost:3001
RAG_TOP_K=3
RAG_MIN_RELEVANCE_SCORE=

# ---------- FastAPI RAG service ----------
RAG_SERVICE_PORT=3001
RAG_DEFAULT_TOP_K=3

# Current project keeps historical "chroma" directory naming, but the active
# vector store is SQLite: CHROMA_PERSIST_DIRECTORY/store.db
CHROMA_PERSIST_DIRECTORY=./rag-service/vector_store/chroma
KNOWLEDGE_PATH=./rag-service/knowledge

# ---------- Embeddings ----------
# Current code supports:
# - simple_hash
# - openai_compatible
EMBEDDING_PROVIDER=simple_hash

# Only required when EMBEDDING_PROVIDER=openai_compatible.
# The endpoint must support OpenAI-compatible /v1/embeddings.
OPENAI_API_KEY=your_embedding_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- OCR ----------
OCR_OUTPUT_DIR=./rag-service/knowledge/ocr_book
OCR_DEFAULT_START_PAGE=1
OCR_DEFAULT_END_PAGE=50
OCR_LANGUAGE=ch
OCR_ZOOM=2.0

# ---------- Hybrid retrieval ----------
BM25_TOP_K=50
VECTOR_TOP_K=50
RRF_K=60
RRF_TOP_N=30
RERANK_TOP_K=8
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
JINA_RERANKER_API_KEY=

# ---------- Parent-child chunking ----------
USE_PARENT_CHILD=true
PARENT_CHUNK_SIZE=1000
PARENT_CHUNK_OVERLAP=100
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50

# ---------- Phase 2 PDF parsing options ----------
GENERATE_TABLE_SUMMARIES=true
GENERATE_IMAGE_CAPTIONS=false
IMAGE_CAPTION_MODEL=deepseek-vl
MIN_TEXT_CHARS_PER_PAGE=50
STATIC_DIR=./rag-service/static
